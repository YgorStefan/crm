# ============================================================
# .gitignore — CRM Empresarial
# ============================================================
# Lista de arquivos e pastas que NÃO devem ir para o repositório.
# Principalmente: credenciais, uploads de usuários e caches.
# ============================================================

# Arquivos .env com variáveis de ambiente reais
.env
.env.local
.env.*.local
.env.production
.env.staging

# --- Uploads de usuários ---
# Arquivos enviados pelos usuários (avatares, anexos).
# Apenas a pasta deve existir (mantemos o .gitkeep).
public/uploads/*
!public/uploads/.gitkeep

# --- Cache e sessões PHP ---
/tmp/
*.cache

# --- Sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs e editores ---
.vscode/
.cursor/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Logs ---
*.log
error_log

# --- Claude Code e planejamento GSD ---
.claude/
.planning/
.superpowers/
CLAUDE.md

# --- Scripts de Infra ---
deploy.sh
bin/deploy.config.ps1

# --- Router PHP built-in (somente dev local; produção usa Apache + .htaccess) ---
router.php

# --- Tailwind CLI binary (downloaded via scripts/setup_tailwind.php) ---
.bin/

# --- Configurações de Servidor PHP ---
public/.user.ini
.user.ini

# --- Credenciais de produção ---
env\ crm.txt

# --- Config de banco (credenciais reais ficam no .env) ---
config/database.php

# --- Scripts descartáveis de uso único ---
# (scripts de produção ficam em database/migrations/ e bin/)
scripts/smoke/
tests/smoke/

# --- Tailwind source e config (versionados) ---
# tailwind.config.js e resources/ foram removidos do ignore

# --- Logs gerados em runtime ---
storage/

# --- Documentação interna (planos e specs ficam somente local) ---
docs/

# --- node_modules, ambientes virtuais e artefatos de teste ---
# package.json/package-lock.json sao versionados (build do Tailwind + Playwright dev).
.venv/
node_modules/
tests/playwright_ui_test.js
tests/playwright_modal_debug.js
tests/screenshots/
