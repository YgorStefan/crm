# ============================================================
# .env.example — Modelo de variáveis de ambiente do CRM
# ============================================================
# COMO USAR:
#   1. Copie para .env (sem extensão):  cp .env.example .env
#   2. Preencha com os valores reais do AMBIENTE em questão.
#   3. NUNCA commite o .env (já está no .gitignore).
#
# REGRA DE OURO:
#   Toda variável que difere entre local e produção mora aqui.
#   Se faltar uma variável em algum ambiente, o app cai pro default
#   definido em config/app.php — o que pode esconder bugs (ex: APP_URL
#   default era /crm/public e prod precisa /crm; gerou 404 em paginação).
# ============================================================

# --- Aplicação ---
# APP_URL: URL base sem barra no final. Tudo que o front gera (links,
#          assets, redirects) usa esse prefixo. ERRO COMUM: deixar local
#          como /crm/public e prod como /crm — links quebram quando o
#          código gera "/clients" em vez de APP_URL . "/clients".
APP_URL=http://localhost/crm
APP_NAME=CRM Empresarial

# APP_ENV: 'development' mostra erros na tela; 'production' oculta.
#          Para diagnosticar bugs que só aparecem em prod, rode local
#          temporariamente com APP_ENV=production.
APP_ENV=development

# --- Segurança / Criptografia ---
# Chave usada para criptografar dados sensíveis (ex: chave da API Google Maps).
# Gere com: php -r "echo 'base64:' . base64_encode(random_bytes(32));"
# O prefixo base64: indica que os bytes brutos serão usados diretamente no AES-256-CBC.
APP_KEY=

# --- Sessão ---
SESSION_NAME=crm_session
SESSION_LIFETIME=7200

# --- Banco de dados (MySQL/MariaDB) ---
# Local típico: usuário root sem senha, banco 'crm'.
# Produção (Hostinger): credenciais geradas no painel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
